{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenSink Docs",
  "colors": {
    "primary": "#0077D0",
    "light": "#0077D0",
    "dark": "#0077D0"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "core-concepts/agents",
              "core-concepts/sinks",
              "core-concepts/sessions",
              "core-concepts/background-jobs"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "agents/configurations",
              "agents/input-requests",
              "agents/activities",
              "agents/execution-endpoints"
            ]
          },
          {
            "group": "Examples & Use Cases",
            "pages": [
              "use-cases/examples",
              "use-cases/overview"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "openapi": "/api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logos/logo-text-black.png",
